# Plantilla de variables para desarrollo local.
#
#     cp .env.example .env.local
#
# Aquí NO van valores reales: solo los nombres, para que quede claro qué hace
# falta. `.env.local` está en .gitignore y nunca se versiona.
#
# Sin las dos primeras, /miembros responde 500 en local: getSupabaseServer()
# lanza "NEXT_PUBLIC_SUPABASE_URL não configurado" antes de renderizar nada.

# ── Imprescindibles ────────────────────────────────────────────────────────
# Supabase → Project Settings → API. La clave anon es publicable por diseño
# (viaja al navegador). Los mismos valores están en wrangler.jsonc.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Medios (avatares, portadas, meditaciones) ──────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_BUCKET=
R2_PUBLIC_URL=

# ── Secretos de servidor ───────────────────────────────────────────────────
# En producción son secrets de Cloudflare, NO están en el repositorio. Sin
# ellos el sitio arranca igual; quedan degradadas solo las rutas que los usan.
SUPABASE_SERVICE_ROLE_KEY=
R2_SECRET_ACCESS_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
DASHBOARD_PASSWORD=
