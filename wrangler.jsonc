{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "los144000",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    { "binding": "AVATARS_BUCKET", "bucket_name": "miembros" },
    { "binding": "MEDIA", "bucket_name": "los144000-media" }
  ],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://kjozrcugsywykpuvuqzu.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imtqb3pyY3Vnc3l3eWtwdXZ1cXp1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA1OTcwNTMsImV4cCI6MjA5NjE3MzA1M30.bp8_Une8jnLU8kMXjPBOGb04h1LgyFEZBLickodyajs",
    "R2_ACCOUNT_ID": "9eb16354b4057b7506df99d12e3463e7",
    "R2_ACCESS_KEY_ID": "0c3a21cb2b05ee38680d71b762b23fa2",
    "R2_BUCKET": "miembros",
    "R2_PUBLIC_URL": "https://pub-f5fdabac2063461c88f966702309c7a3.r2.dev"
  },
  "env": {
    "staging": {
      "name": "los144000-staging",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
        "html_handling": "none"
      },
      "observability": {
        "enabled": true
      }
    }
  }
  // Env vars / secrets configurados via dashboard CF ou:
  //   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
  //   npx wrangler secret put R2_SECRET_ACCESS_KEY
  //
  // VARS (vão em [vars] ou dashboard — públicas, não-sensíveis):
  //  - NEXT_PUBLIC_SUPABASE_URL
  //  - NEXT_PUBLIC_SUPABASE_ANON_KEY
  //  - R2_ACCOUNT_ID
  //  - R2_ACCESS_KEY_ID
  //  - R2_BUCKET
  //  - R2_PUBLIC_URL
  //
  // SECRETS (sensíveis — sempre via `wrangler secret put`):
  //  - SUPABASE_SERVICE_ROLE_KEY
  //  - R2_SECRET_ACCESS_KEY
}
